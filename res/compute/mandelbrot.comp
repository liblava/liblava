#version 450

// Mandelbrot Compute Shader (adapted for Vulkan compute pipeline)
// https://iquilezles.org/articles/arquimedes/arquimedes.pdf
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform Params {
    float time;
};

layout(set = 0, binding = 1, rgba8) uniform image2D OutputImage;

vec3 hsv2rgb(vec3 c) {
    vec3 K = vec3(1.0, 2.0 / 3.0, 1.0 / 3.0);
    vec3 p = abs(fract(c.x + K) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

void main() {
    ivec2 size = imageSize(OutputImage);
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= size.x || gid.y >= size.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(size);
    float aspect = float(size.x) / float(size.y);

    vec2 center = vec2(-0.75, 0.0) + 0.2 * vec2(0.5 * sin(time * 0.3), 0.25 * cos(time * 0.15));
    float zoom = exp(-0.5 * sin(time * 0.07)) * 0.7;
    float scale = 1.5 * zoom;

    vec2 c = vec2(
        (uv.x - 0.5) * 2.0 * scale * aspect + center.x,
        (uv.y - 0.5) * 2.0 * scale + center.y
    );

    vec2 z = vec2(0.0);
    int maxIter = 1000;
    int i;
    float escapeRadius2 = 4.0;
    float zn2 = 0.0;

    for (i = 0; i < maxIter; ++i) {
        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        zn2 = dot(z, z);
        if (zn2 > escapeRadius2) break;
    }

    float iterf = float(i);
    if (i < maxIter) {
        float log_zn = 0.5 * log(zn2);
        float nu = log(log_zn / log(2.0)) / log(2.0);
        iterf = float(i) + 1.0 - nu;
    }

    vec3 color = (i == maxIter)
        ? vec3(0.0)
        : hsv2rgb(vec3(fract(0.95 - iterf * 0.02), 0.8, 0.8));

    color = pow(color, vec3(0.4545));
    imageStore(OutputImage, gid, vec4(color, 1.0));
}
